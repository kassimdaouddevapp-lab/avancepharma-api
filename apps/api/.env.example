# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avancepharma
DB_USER=postgres
DB_PASSWORD=password
DB_URL=postgresql://postgres:password@localhost:5432/avancepharma

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT - Chemins vers les clés (générées avec npm run keys:generate)
JWT_PRIVATE_KEY_PATH=apps/api/keys/private.pem
JWT_PUBLIC_KEY_PATH=apps/api/keys/public.pem

# Application
PORT=3000
NODE_ENV=development

# Clés JWT (optionnel - générées automatiquement)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."