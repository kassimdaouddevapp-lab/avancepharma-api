# Configuration Supabase pour la migration
# Remplissez avec vos credentials depuis le dashboard Supabase
# Trouvez ces informations ici : https://app.supabase.com/project/[YOUR_PROJECT]/settings/database

# Host (Database Host)
SUPABASE_HOST=your-project-ref.supabase.co

# Port (habituellement 5432)
SUPABASE_PORT=5432

# Database name (habituellement 'postgres')
SUPABASE_DB=postgres

# Username (habituellement 'postgres')
SUPABASE_USER=postgres

# Password (la password de la base de données)
SUPABASE_PASSWORD=your-secure-password-here